{
  "schemaVersion": 1,
  "id": "ias",
  "version": "${version}",
  "name": "In-Game Account Switcher with Cookies",
  "description": "Allows you to change which account you are signed in to in-game without restarting Minecraft.",
  "authors": [
    "naczo5",
    "VidTu"
  ],
  "contributors": [
    "Articuling",
    "The_Fireplace",
    "The_BrainStone",
    "2xsaiko",
    "Elvm",
    "Fhilips613",
    "WyattMarks"
  ],
  "contact": {
    "homepage": "https://github.com/naczo5/Account-Switcher-with-Cookies",
    "sources": "https://github.com/naczo5/Account-Switcher-with-Cookies",
    "issues": "https://github.com/naczo5/Account-Switcher-with-Cookies/issues"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "ias.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      //? if >=1.21.8 {
      "ru.vidtu.ias.platform.IFabric"
      //?} else {
      /*"ru.vidtu.ias.IASFabric"
      *///?}
    ],
    "modmenu": [
      //? if >=1.21.8 {
      "ru.vidtu.ias.platform.IModMenu"
      //?} else {
      /*"ru.vidtu.ias.IASModMenu"
      *///?}
    ]
  },
  "mixins": [
    {
      "config": "ias.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "minecraft": "${minecraft}",
    "fabric-lifecycle-events-v1": "*",
    "fabric-resource-loader-${fabricResourceLoaderRevision}": "*",
    "fabric-screen-api-v1": "*"
  },
  "recommends": {
    "${fabricApiName}": "*",
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github_releases": "https://github.com/naczo5/Account-Switcher-with-Cookies/releases",
        "modmenu.sources": "https://github.com/naczo5/Account-Switcher-with-Cookies",
        "modmenu.issues": "https://github.com/naczo5/Account-Switcher-with-Cookies/issues"
      }
    },
    "catalogue": {
      "icon": {
        "image": "ias.png",
        "item": "player_head"
      },
      "banner": "ias.png"
    }
  }
}
